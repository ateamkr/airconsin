# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Required for verifying admin login on Netlify Functions and local server.
# Configure this in Netlify: Site Configuration -> Environment variables -> ADMIN_PASSWORD
ADMIN_PASSWORD="8849"

# ADMIN_SESSION_SECRET: Optional secret key used to HMAC-sign admin session tokens.
ADMIN_SESSION_SECRET="airconsin-secure-random-secret-key"

# NETLIFY_BLOBS: Automatically injected by Netlify when Netlify Blobs is enabled.
# For local standalone testing outside Netlify, optionally provide SITE_ID and NETLIFY_AUTH_TOKEN:
# NETLIFY_BLOBS_SITE_ID=""
# NETLIFY_BLOBS_TOKEN=""
